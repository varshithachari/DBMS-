# ==============================================================================
# Chanakya Campus Connect - Environment Configuration Example
# ==============================================================================

# Application Port
PORT=3000

# Node Environment ('development' or 'production')
NODE_ENV=development

# JWT Secret for Session & Token Signature (Change in production!)
JWT_SECRET=chanakya_campus_connect_jwt_secret_2026_xyz_production_key

# Database Connection (Optional - defaults to persistent JSON relational store)
# SUPABASE_URL=https://your-supabase-project.supabase.co
# SUPABASE_KEY=your-supabase-anon-or-service-key
# DATABASE_URL=postgresql://postgres:password@localhost:5432/chanakya_db

# Email Service SMTP Configuration (Optional - for real password recovery emails)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=notifications@chanakya.edu
# SMTP_PASS=your-app-password
